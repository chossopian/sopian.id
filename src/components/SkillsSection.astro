---
import { skillGroups } from '../data/profile';

const icons: Record<string, string> = {
  'IT & Enterprise Administration': 'M9 3v18M15 3v18M3 9h18M3 15h18',
  'Workflow & Business Automation': 'M13 2L3 14h9l-1 8 10-12h-9l1-8z',
  'Cloud & DevOps Infrastructure': 'M3 15a4 4 0 004 4h11a3 3 0 001-5.83A3.5 3.5 0 0015 8.5h-.5A5 5 0 006 10a3 3 0 00-3 5z',
  'AI & LLM Orchestration': 'M12 2a3 3 0 013 3v1a3 3 0 01-3 3 3 3 0 01-3-3V5a3 3 0 013-3zM5.5 8.5a2.5 2.5 0 105 0 2.5 2.5 0 00-5 0zM13.5 8.5a2.5 2.5 0 105 0 2.5 2.5 0 00-5 0zM12 22a3 3 0 003-3v-1a3 3 0 00-3-3 3 3 0 00-3 3v1a3 3 0 003 3z',
  'Backend & Database Management': 'M4 7v10c0 1.66 3.58 3 8 3s8-1.34 8-3V7M4 7c0 1.66 3.58 3 8 3s8-1.34 8-3M4 7c0-1.66 3.58-3 8-3s8 1.34 8 3',
};
---

<section id="about" class="max-w-5xl mx-auto px-6 py-20 md:py-28">
  <div data-reveal class="mb-12">
    <p class="text-sm font-semibold text-emerald-500 mb-2">What I work with</p>
    <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white tracking-tight">
      Skills & Competencies
    </h2>
  </div>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
    {skillGroups.map((group, i) => (
      <div
        data-reveal
        style={`transition-delay: ${i * 80}ms`}
        class="group p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50/50 dark:bg-neutral-900/50 hover:border-emerald-500/50 hover:shadow-lg hover:shadow-emerald-500/5 transition-all duration-300"
      >
        <div class="h-10 w-10 rounded-lg bg-emerald-500/10 flex items-center justify-center mb-4 text-emerald-500 group-hover:scale-110 transition-transform">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d={icons[group.title] || 'M12 2l9 4.5v9L12 20l-9-4.5v-9z'} />
          </svg>
        </div>
        <h3 class="font-semibold text-neutral-900 dark:text-white mb-3">{group.title}</h3>
        <ul class="space-y-1.5">
          {group.skills.map((skill) => (
            <li class="text-sm text-neutral-600 dark:text-neutral-400 flex items-start gap-2">
              <span class="text-emerald-500 mt-1">&bull;</span>
              <span>{skill}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
