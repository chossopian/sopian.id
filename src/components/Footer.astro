---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer id="contact" class="border-t border-neutral-200 dark:border-neutral-800 mt-24">
  <div class="max-w-5xl mx-auto px-6 py-16">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-8">
      <div>
        <p class="text-sm font-medium text-emerald-500 mb-2">Get in touch</p>
        <h2 class="text-3xl md:text-4xl font-bold text-neutral-900 dark:text-white tracking-tight">
          Let's build something<br class="hidden md:block" /> useful together.
        </h2>
      </div>
      <a
        href={`mailto:${profile.email}`}
        class="inline-flex items-center gap-2 bg-neutral-900 dark:bg-emerald-500 text-white px-6 py-3 rounded-full text-sm font-semibold hover:bg-neutral-700 dark:hover:bg-emerald-400 transition-colors w-fit"
      >
        Say hello
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M13 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <div class="mt-12 pt-8 border-t border-neutral-200 dark:border-neutral-800 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-neutral-500">
      <p>&copy; {year} {profile.name}. All rights reserved.</p>
      <div class="flex items-center gap-6">
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="hover:text-emerald-500 transition-colors">LinkedIn</a>
        <a href={`mailto:${profile.email}`} class="hover:text-emerald-500 transition-colors">Email</a>
        <a href="/blog" class="hover:text-emerald-500 transition-colors">Blog</a>
      </div>
    </div>
  </div>
</footer>
